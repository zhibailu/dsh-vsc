{
  "name": "dsh-vsc",
  "displayName": "DSH Bridge",
  "description": "DeepSeek Harness (DSH) in VS Code: native sidebar panel + editor bridge for the local AI agent — a pure protocol client, no second server.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "ai",
    "agent",
    "ai-agent",
    "local-ai",
    "vscode",
    "vscode-extension",
    "vs-code",
    "ide",
    "code-assistant",
    "sidebar",
    "protocol-client",
    "harness"
  ],
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "author": "zhibailu",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhibailu/dsh-vsc.git"
  },
  "homepage": "https://github.com/zhibailu/dsh-vsc",
  "bugs": {
    "url": "https://github.com/zhibailu/dsh-vsc/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pure bridge to the local DSH harness (127.0.0.1:3080): panel, status bar, editor context. No workspace code is executed."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-right",
          "title": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh-right": [
        {
          "type": "webview",
          "id": "dsh.sidebar.right",
          "name": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openSidebar",
        "title": "DSH: Open Sidebar"
      },
      {
        "command": "dsh.start",
        "title": "DSH: Start Web Harness"
      },
      {
        "command": "dsh.stop",
        "title": "DSH: Stop Auto-started Harness"
      },
      {
        "command": "dsh.refreshStatus",
        "title": "DSH: Refresh Connection Status"
      },
      {
        "command": "dsh.openWebView",
        "title": "DSH: Open Web GUI (advanced)"
      },
      {
        "command": "dsh.askSelection",
        "title": "DSH: Ask about selection",
        "enablement": "editorHasSelection"
      },
      {
        "command": "dsh.reviewChanges",
        "title": "DSH: Review Agent Changes"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "dsh.reviewChanges"
        }
      ]
    },
    "configuration": {
      "title": "DSH Bridge",
      "properties": {
        "dshVsc.url": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "Base URL of the DSH harness this extension talks to. Default 3080 = the web GUI's harness: the extension connects as a shared client and never starts or kills it. If nothing answers there, the extension auto-starts its own instance (recorded in %TEMP%\\dsh-vsc-harness.pid, stopped when VS Code exits). Also honors DSH_WEB_URL."
        },
        "dshVsc.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `dsh web` automatically when no harness is reachable at the configured URL."
        },
        "dshVsc.token": {
          "type": "string",
          "default": "",
          "description": "DSH 0.2.1 起，所有 /api 调用与事件流都要用 `dsh web` 启动时打印的 token 换 cookie。本扩展自己启动的服务会自动从启动输出里读到 token，无需填写；只有手动运行了 `dsh web`（或连 WSL 里的实例）时才需要把那条带 token=… 的 URL 或 token 本身粘到这里。token 每次启动都会变。"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "ws": "^8.22.0"
  }
}
