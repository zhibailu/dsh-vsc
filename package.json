{
  "name": "dsh-vsc",
  "displayName": "DSH Bridge",
  "description": "DeepSeek Harness in VS Code: embedded Web GUI plus native editor bridge (context, diff review, file jumps).",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dsh.right",
          "title": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh.right": [
        {
          "type": "webview",
          "id": "dsh.sidebar.right",
          "name": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openSidebar",
        "title": "DSH: Open Sidebar"
      },
      {
        "command": "dsh.start",
        "title": "DSH: Start Web Harness"
      },
      {
        "command": "dsh.stop",
        "title": "DSH: Stop Auto-started Harness"
      },
      {
        "command": "dsh.refreshStatus",
        "title": "DSH: Refresh Connection Status"
      },
      {
        "command": "dsh.openWebView",
        "title": "DSH: Open Web GUI (advanced)"
      },
      {
        "command": "dsh.askSelection",
        "title": "DSH: Ask about selection",
        "enablement": "editorHasSelection"
      },
      {
        "command": "dsh.reviewChanges",
        "title": "DSH: Review Agent Changes"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.askSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "dsh.reviewChanges"
        }
      ]
    },
    "configuration": {
      "title": "DSH Bridge",
      "properties": {
        "dshVsc.url": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "Base URL of the running DSH web harness (also honors DSH_WEB_URL)."
        },
        "dshVsc.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `dsh web` automatically when no harness is reachable at the configured URL."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
